[Unit]
Description=Soberized restricted virtual gamepad helper
Requires=soberized-helper.socket
After=soberized-helper.socket systemd-modules-load.service
StartLimitIntervalSec=30s
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/lib/soberized/soberized-helper --owner-uid @OWNER_UID@
OpenFile=/dev/uinput:uinput
DynamicUser=yes
User=soberized-helper
Restart=no
TimeoutStopSec=2s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
# PrivateDevices closes the device cgroup before OpenFile handles are prepared.
# Allow only this device; the private /dev and runtime syscall filter still hide
# and prevent reopening it after the fixed controller has been configured.
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
TasksMax=1
MemoryMax=64M
CPUQuota=10%
LimitNOFILE=32
LimitCORE=0
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
StandardInput=null
StandardOutput=journal
StandardError=journal
